{
  "expo": {
    "name": "NovaEdge",
    "slug": "novaedge-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-app.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon-app.png",
      "resizeMode": "contain",
      "backgroundColor": "#090c15"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "in.novaedgedigitallabs.tech",
      "versionCode": 26,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-app.png",
        "backgroundColor": "#0a0a0f"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "sdkVersion": "55.0.0",
    "plugins": [
      "expo-video",
      "expo-notifications",
      "./plugins/withHermesFix",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow NovaEdge to save images to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "68c86361-f438-46b3-82a3-34df4ab03cb0"
      }
    },
    "owner": "amitkumarraikwar"
  }
}
